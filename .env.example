SPORTAPI_KEY=
# Set this only if you already know the SportAPI fixture ID.
SPORTAPI_FIXTURE_ID=
# Polling during play. Three hours at 6 seconds is up to 1,800 requests.
SPORTAPI_POLL_SECONDS=6

# Vercel + Neon. Kosongkan keduanya untuk app lokal di PC vMix (state disimpan di .scoreboard/).
# DATABASE_URL = pooled (-pooler) untuk app, DATABASE_URL_UNPOOLED = direct untuk migrasi.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Wajib di Vercel. Melindungi panel operator dan perubahan skor. Buat dengan `openssl rand -base64 24`.
# Kosong = panel hanya terbuka dari 127.0.0.1.
OPERATOR_PASSWORD=
